   "fieldname": "column_break_sms",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "sms_provider",
   "fieldtype": "Select",
   "label": "SMS Provider",
   "options": "\nAfrica's Talking\nCustom Gateway",
   "depends_on": "eval:doc.enable_sms_notifications"
  },
  {
   "fieldname": "sms_sender_id",
   "fieldtype": "Data",
   "label": "SMS Sender ID",
   "depends_on": "eval:doc.enable_sms_notifications"
  },
  {
   "fieldname": "sms_api_url",
   "fieldtype": "Data",
   "label": "SMS API URL",
   "depends_on": "eval:doc.enable_sms_notifications"
  },
  {
   "fieldname": "sms_api_key",
   "fieldtype": "Password",
   "label": "SMS API Key",
   "depends_on": "eval:doc.enable_sms_notifications"
  },
  {
   "fieldname": "sms_api_username",
   "fieldtype": "Data",
   "label": "SMS API Username",
   "depends_on": "eval:doc.enable_sms_notifications"
  },
  {
   "fieldname": "email_sb",
   "fieldtype": "Section Break",
   "label": "Email Request Intake"
  },
  {
   "fieldname": "enable_email_intake",
   "fieldtype": "Check",
   "label": "Enable Email Request Intake",
   "default": "0",
   "description": "Governs enrichment (Internal/External detection, auto-submit, acknowledgement) once an email creates a ticket. It does not by itself make emails create tickets - that still needs an Email Account with Append To = Facilities Work Order (see README)."
  },
  {
   "fieldname": "email_send_acknowledgement",
   "fieldtype": "Check",
   "label": "Send Acknowledgement Reply",
   "default": "1",
   "depends_on": "eval:doc.enable_email_intake"
  },
  {
   "fieldname": "email_alerts_sb",
   "fieldtype": "Section Break",
   "label": "Email Alerts",
   "depends_on": "eval:doc.enable_email_notifications"
  },
  {
   "fieldname": "email_notify_new_ticket",
   "fieldtype": "Check",
   "label": "Alert Managers on New Ticket",
   "default": "1",
   "depends_on": "eval:doc.enable_email_notifications"
  },
  {
   "fieldname": "email_notify_replies",
   "fieldtype": "Check",
   "label": "Forward Ticket Replies and Comments to Assignee",
   "default": "1",
   "depends_on": "eval:doc.enable_email_notifications"
  },
  {
   "fieldname": "email_notify_sla_breach",
   "fieldtype": "Check",
   "label": "Alert on SLA Breach",
   "default": "1",
   "depends_on": "eval:doc.enable_email_notifications"
  },
  {
   "fieldname": "email_reopen_on_reply",
   "fieldtype": "Check",
   "label": "Reopen Completed/Closed Ticket on Customer Reply",
   "default": "1",
   "depends_on": "eval:doc.enable_email_notifications"
  },
  {
   "fieldname": "email_send_booking_invites",
   "fieldtype": "Check",
   "label": "Email Booking Confirmations with Calendar Invite",
   "default": "1",
   "depends_on": "eval:doc.enable_email_notifications"
  },
  {
   "fieldname": "whatsapp_sb",
   "fieldtype": "Section Break",
   "label": "WhatsApp Integration (Meta Cloud API)"
  },
  {
   "fieldname": "enable_whatsapp_intake",
   "fieldtype": "Check",
   "label": "Enable WhatsApp Request Intake",
   "default": "0"
  },
  {
   "fieldname": "whatsapp_send_acknowledgement",
   "fieldtype": "Check",
   "label": "Send Acknowledgement Reply",
   "default": "1",
   "depends_on": "eval:doc.enable_whatsapp_intake"
  },
  {
   "fieldname": "column_break_whatsapp",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "whatsapp_phone_number_id",
   "fieldtype": "Data",
   "label": "WhatsApp Phone Number ID",
   "depends_on": "eval:doc.enable_whatsapp_intake"
  },
  {
   "fieldname": "whatsapp_verify_token",
   "fieldtype": "Data",
   "label": "Webhook Verify Token",
   "depends_on": "eval:doc.enable_whatsapp_intake"
  },
  {
   "fieldname": "whatsapp_access_token",
   "fieldtype": "Password",
   "label": "Cloud API Access Token",
   "depends_on": "eval:doc.enable_whatsapp_intake"
  },
  {
   "fieldname": "whatsapp_api_version",
   "fieldtype": "Data",
   "label": "Graph API Version",
   "default": "v20.0",
   "depends_on": "eval:doc.enable_whatsapp_intake"
  },
  {
   "fieldname": "ticket_auto_close_days",
   "fieldtype": "Int",
   "label": "Auto-close Resolved Tickets After (days)",
   "default": "3"
  },
  {
   "fieldname": "acknowledgement_hours",
   "fieldtype": "Int",
   "label": "Acknowledge Work Orders Within (hours)",
   "default": "24",
   "description": "ABS procedure, step 4: Facilities must acknowledge receipt within 24 hours."
  },
  {
   "fieldname": "require_completion_confirmation",
   "fieldtype": "Check",
   "label": "Require Written Completion Confirmation Before Closing",
   "default": "1",
   "description": "Step 8-9: written client confirmation and a Facilities inspection are needed to close a work order and to approve final payment."
  },
  {
   "fieldname": "ntsa_sb",
   "fieldtype": "Section Break",
   "label": "Vehicle Compliance (NTSA, Insurance, Speed Governor)"
  },
  {
   "fieldname": "ntsa_reminders_enabled",
   "fieldtype": "Check",
   "label": "Send Vehicle Compliance Reminders",
   "default": "1"
  },
  {
   "fieldname": "ntsa_reminder_days",
   "fieldtype": "Data",
   "label": "Remind Before Expiry (days)",
   "default": "30,14,7,3,1",
   "description": "Comma separated. Applies to NTSA inspection, insurance and speed governor. A reminder goes out on each of these days before expiry."
  },
  {
   "fieldname": "ntsa_overdue_reminder_every_days",
   "fieldtype": "Int",
   "label": "Repeat Overdue Reminder Every (days)",
   "default": "7"
  },
  {
   "fieldname": "ntsa_auto_create_booking",
   "fieldtype": "Check",
   "label": "Create a Planned Booking Automatically",
   "default": "1"
  },
  {
   "fieldname": "ntsa_auto_booking_lead_days",
   "fieldtype": "Int",
   "label": "Create It This Many Days Before Due",
   "default": "30"
  },
  {
   "fieldname": "ntsa_cb",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "ntsa_booking_reminder_days",
   "fieldtype": "Data",
   "label": "Remind Before Appointment (days)",
   "default": "3,1,0"
  },
  {
   "fieldname": "block_expired_ntsa_bookings",
   "fieldtype": "Check",
   "label": "Block Vehicle Bookings When Insurance, NTSA Inspection or Speed Governor Has Expired",
   "default": "0",
   "description": "Off: staff see a warning only. On: the booking cannot be saved."
  }
