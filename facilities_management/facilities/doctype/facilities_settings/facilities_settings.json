 "fields": [
  {
   "fieldname": "naming_sb",
   "fieldtype": "Section Break",
   "label": "Work Order Numbering"
  },
  {
   "fieldname": "work_order_naming_series",
   "fieldtype": "Data",
   "label": "Work Order Naming Series",
   "default": "WO-.YYYY.-"
  },
  {
   "fieldname": "default_priority",
   "fieldtype": "Select",
   "label": "Default Priority",
   "options": "Low\nMedium\nHigh\nCritical",
   "default": "Medium"
  },
  {
   "fieldname": "auto_close_after_days",
   "fieldtype": "Int",
   "label": "Auto-close Completed Orders After (days)",
   "default": "7"
  },
  {
   "fieldname": "column_break_sla",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
