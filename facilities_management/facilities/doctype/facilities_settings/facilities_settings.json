   "fieldtype": "Link",
   "label": "Default Approver",
   "options": "User"
  },
  {
   "fieldname": "escalation_hours",
   "fieldtype": "Int",
   "label": "Escalate If Unassigned After (hours)",
   "default": "24"
  },
  {
   "fieldname": "working_hours_start",
   "fieldtype": "Time",
   "label": "Working Hours Start"
  },
  {
   "fieldname": "working_hours_end",
   "fieldtype": "Time",
   "label": "Working Hours End"
  },
  {
